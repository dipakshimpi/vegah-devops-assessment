# Ignore node_modules — Docker installs them fresh inside the image
node_modules/

# Ignore build output — the builder stage compiles fresh
dist/

# Ignore environment files — secrets must NEVER be baked into an image
.env
.env.*
!.env.example

# Ignore git metadata — not needed inside the container
.git
.gitignore

# Ignore logs
*.log
npm-debug.log*

