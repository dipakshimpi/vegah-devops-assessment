# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_example
POSTGRES_DB=vegah_db
DATABASE_URL=postgresql://postgres:postgres_password_example@postgres:5432/vegah_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Backend
BACKEND_PORT=3001

# Web / Reverse Proxy (Caddy)
# Local: :80 | Production: example.nip.io
SITE_ADDRESS=:80

# Registry & Image Tag (CI/CD / Production)
REGISTRY=ghcr.io/your-username/vegah
TAG=latest

