# Dependencies (in root and all subfolders)
node_modules/
**/node_modules/

# Build outputs (in root and all subfolders)
dist/
**/dist/
.next/
**/.next/
out/
**/out/
build/
**/build/
*.tsbuildinfo
**/*.tsbuildinfo

# Environment files (never commit secrets)
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Temporary files & heartbeats
*.tmp
**/*.tmp
heartbeat.tmp
**/heartbeat.tmp

# Keys and credentials
*.pem
**/*.pem
*.key
**/*.key

# Logs
*.log
**/*.log
npm-debug.log*
yarn-debug.log*

# OS metadata
.DS_Store
Thumbs.db

# Terraform state and local files
.terraform/
**/.terraform/
*.tfstate
*.tfstate.*
terraform.tfstate*
*.tfvars
!*.example.tfvars
